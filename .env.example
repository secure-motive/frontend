# Base URL of the SecureXmotive backend (Node.js + Express), without a trailing slash.
# The backend is a separate project — this frontend never modifies it.
VITE_API_BASE_URL=http://localhost:5000

# Set to true once the backend contract is verified. While false, forms validate
# and show their states but send nothing (preview mode).
VITE_ENABLE_API=false

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

