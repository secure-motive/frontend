# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=xmotivebase
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Designated Firebase Admin UID authorized to access Admin Portal
VITE_FIREBASE_ADMIN_UID=

# AWS S3 Storage (Server-side only — used by Vite dev middleware & Vercel serverless functions)
# Keep confidential; do NOT add VITE_ prefix.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=secure-motive-files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
